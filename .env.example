# Шаблон .env. Создать .env со сгенерированными паролями:
#   Linux/macOS: bash generate-env.sh
#   Windows:     .\generate-env.ps1
# Или вручную: скопировать в .env и заполнить пустые *_PASSWORD (openssl rand -hex 16)

# Интерфейс, на котором публикуются порты:
#   127.0.0.1 — доступ только с самого сервера (или через SSH-туннель)
#   0.0.0.0   — доступ снаружи (обязательно ограничьте фаерволом)
BIND_IP=127.0.0.1

# Состав стека: поднимается только перечисленное — уберите ненужные сервисы
# (данные выключенного сервиса остаются в volume; применить изменение:
# bash deploy/apply-profiles.sh). pgAdmin работает и без postgres.
# Опциональный minio (EOL, для ещё не переехавших приложений) — добавьте в список.
# Опциональный мониторинг (Prometheus + Grafana, ~0.5-0.7 ГБ RAM) — добавьте monitoring.
COMPOSE_PROFILES=mongodb,redis,rabbitmq,seaweedfs,postgres,pgadmin

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_PORT=27017

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=
# 5672 — AMQP, 15672 — веб-интерфейс управления
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- SeaweedFS (объектное S3-хранилище по умолчанию) ---
# USER/PASSWORD — это и S3-креды (access key / secret key), и логин веб-админки.
# Применяются при старте контейнера: смена = docker compose up -d seaweedfs.
SEAWEEDFS_USER=admin
SEAWEEDFS_PASSWORD=
# 8333 — S3 API, 23646 — веб-админка
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=23646

# --- MinIO (опция, по умолчанию выключен — см. COMPOSE_PROFILES) ---
# Пароль — минимум 8 символов
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
# 9000 — S3 API, 9001 — веб-консоль
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL ---
# База по умолчанию называется так же, как пользователь
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- pgAdmin ---
# Email — логин в веб-интерфейсе (формат должен быть email-ом)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# --- Мониторинг (опциональный профиль monitoring) ---
# Логин/пароль веб-интерфейса Grafana; применяются при первой инициализации volume
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Бэкапы ---
# Выгрузка backup/ во внешнее хранилище (см. README, backup-sync.sh):
#   s3:bucket/infra-backup — rclone-remote, user@host:/path — rsync по SSH,
#   /mnt/nas/infra — локальный каталог. Пусто — выгрузка отключена.
BACKUP_REMOTE=
