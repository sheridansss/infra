# Осознанно принятые находки CVE-скана (security.yml). Каждая запись — с
# обоснованием и условием удаления.

# CRITICAL в go stdlib (crypto/tls, TLS session resumption) внутри бинаря gosu,
# вшитого в официальные образы postgres/mongo. gosu используется только для
# сброса привилегий на старте контейнера и не устанавливает TLS-соединений —
# уязвимый код недостижим. Пересобрать бинарь со своей стороны нельзя.
# Убрать запись, когда апстрим пересоберёт образы с новым Go (скан перестанет
# находить CVE). Добавлено: 2026-07-31.
CVE-2025-68121

# CRITICAL в библиотеке kin-openapi внутри бинаря Grafana 13.1.1: фикс в
# библиотеке вышел, релиза Grafana с ним ещё нет (13.1.1 — последний тег).
# Grafana привязана к loopback (BIND_IP по умолчанию) и закрыта
# аутентификацией. Убрать, когда Dependabot принесёт тег новее 13.1.1.
# Добавлено: 2026-07-31.
GHSA-r277-6w6q-xmqw

# CRITICAL в образе cadvisor v0.55.1 (openssl в alpine-базе и grpc-клиент):
# образы cadvisor публикуются с большим отставанием, v0.55.1 — последний
# существующий. Порт cadvisor наружу не публикуется (только внутренняя
# docker-сеть), TLS он не терминирует, grpc — только клиент к доверенному
# локальному containerd. Убрать при выходе следующего образа cadvisor
# (Dependabot принесёт). Добавлено: 2026-07-31.
CVE-2026-31789
CVE-2026-33186
